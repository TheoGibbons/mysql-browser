# Local run through the shared hobby-traefik proxy.
#
#   cp .env.traefik.example .env && bash scripts/up-local-traefik.sh
#   http://mysql-browser.localhost:8085
#
# 8085 is hobby-traefik's local HTTP port; production uses 80/443. No host port
# is published in this mode, so SITE_BIND and SITE_PORT are unused.

APP_HOST=mysql-browser.localhost

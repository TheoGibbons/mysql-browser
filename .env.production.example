# LIVE values, used with scripts/deploy.sh.
#
# APP_HOST's DNS record must already point at this instance before the first
# deploy, or Let's Encrypt cannot validate the hostname and no certificate is
# issued. The Traefik overlay marks it required, so `docker compose config`
# fails by name if it is left blank.
APP_HOST=mysql-browser.sinkmailer.com

# Unused behind Traefik — the site is reached on 443 through the proxy and
# publishes no host port of its own. They matter only for a standalone LIVE
# deploy without the proxy, where SITE_BIND=0.0.0.0 and SITE_PORT=80 is the
# entire difference from a local run.
#SITE_BIND=0.0.0.0
#SITE_PORT=80

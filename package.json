{
  "name": "mysql-browser",
  "version": "0.1.9",
  "description": "A fast, parallel MySQL browser for Windows",
  "main": "./out/main/index.js",
  "author": "theo",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "electron scripts/build-icon.cjs",
    "dist": "electron-vite build && electron-builder --win --dir",
    "dist:installer": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --config scripts/electron-builder-release.cjs --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mysql2": "^3.11.5",
    "pg": "^8.22.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql-formatter": "^15.4.9",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "co.joypilot.mysqlbrowser",
    "productName": "MySQL Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**"
    ],
    "npmRebuild": false,
    "artifactName": "MySQL-Browser-Setup-${version}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MySQL Browser"
    },
    "publish": {
      "provider": "github",
      "owner": "TheoGibbons",
      "repo": "mysql-browser",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
